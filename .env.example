# ── Required ─────────────────────────────────────────────────────
GROQ_API_KEY=                    # free at console.groq.com — powers every agent's think() call

# ── Database (optional — defaults to local SQLite if left blank) ──
# Set both to switch to Supabase/Postgres in production.
SUPABASE_URL=
SUPABASE_KEY=

# ── Email digest (optional — send_digest silently no-ops until all set) ──
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Optional extras ─────────────────────────────────────────────
NEWS_API_KEY=                    # free at newsapi.org — only used by KAEL's NewsAPI fallback
GROQ_DAILY_BUDGET=95000          # token ceiling/day — default leaves ~5k margin under Groq's free-tier cap
RENDER_EXTERNAL_URL=             # auto-set by Render; only needed to test self-ping locally
PORT=5000                        # auto-set by Render; used for local runs
